# Extracted GRF assets — large, regenerated from the client via extract-grf.mjs
/resources/

# Local analysis scratch (GRF dumps, decoded tables, replay harvest) — large, regenerated
/_scratch/

# Packaged resources for transfer
*.tar
*.tar.gz

# Resume state from an interrupted tools/scrape-mobs.mjs run
*.partial.jsonl

# Node
node_modules/

# Local env overrides (commit .env.example instead)
.env

# Exported divine-pride session, if one is ever needed again. The LATAM stat
# block is served anonymously, so tools/crawl-divine-pride.mjs only reads this
# file when it exists — but it is a live login, so it must never be committed.
.dp-cookies.json

# Go build artifacts (the gateway is normally built inside Docker)
/gateway/ragassets-gateway
/gateway/*.exe

# Local Claude settings
.claude/settings.local.json
.claude/skills/deploy/

# OS junk
Thumbs.db
.DS_Store

# Per-cycle scratch from tools/patch-cycle.mjs. _patchdl is the download staging
# directory apply-patches.mjs creates beside --out; it removes it on a clean exit
# but not on a crash, so it has to be ignored rather than assumed transient.
/patch-report.json
/patchfiles/
/_patchdl/

# The merged client mirror and the loose client files beside it, on a server that
# runs the extraction. Tens of gigabytes, reproduced from data.grf plus patches.
/mirror/
/System/
/BGM/
