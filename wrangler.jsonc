{
  // The Worker is Go compiled to wasm; ./gateway/build is produced by
  // tools/build-worker.sh (workers-assets-gen writes the JS shim, then the Go
  // build writes app.wasm beside it). ./public is produced by
  // tools/stage-assets.sh.
  "name": "ragassets",
  "main": "./gateway/build/worker.mjs",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],

  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "ragassets" }],

  // State for the patch poll: the last patch.txt ETag and the highest patch
  // sequence already dispatched. Two keys, read every 10 minutes and written
  // only when something actually changed.
  "kv_namespaces": [
    { "binding": "UPDATE_STATE", "id": "ea027318b5124243bbf88f13ab73e0ab" }
  ],

  // Every 10 minutes. The poll is one conditional GET of a 70 KB index —
  // measured at 304 in 0 bytes and ~130 ms — so ~4,380 invocations a month,
  // comfortably inside the 10M included requests.
  "triggers": { "crons": ["*/10 * * * *"] },

  // Where the patch poll sends repository_dispatch. Not a secret — the token
  // that authorises it is (wrangler secret put GITHUB_TOKEN).
  "vars": { "GITHUB_REPO": "adsonpleal/ragassets" },

  "assets": {
    // icons, illust, effects and raw — 39,241 files, 298 MB. Requests to static
    // assets are free and unmetered, and these are 69% of all traffic by
    // measurement, so serving them here rather than through the Worker is what
    // keeps billed Worker requests inside the 10M included each month.
    //
    // No `binding`: the Worker never needs to read them. The platform answers
    // these before the request reaches Go.
    "directory": "./public",

    // MUST be an array, never `true`. As a boolean this routes EVERY request
    // through the Worker, which puts all 39k static assets on the Worker request
    // budget and throws away the entire reason they are here. Both sibling repos
    // carry this warning after being caught by it.
    //
    // Listed here: only paths that render, read R2, or are computed. Everything
    // else falls through to the free asset path.
    "run_worker_first": [
      "/",
      "/healthz",
      "/image*",
      "/gif*",
      "/maps/*",
      "/bgm/*",
      "/effect/*",
      "/debug/*"
    ]
  },

  "observability": { "logs": { "enabled": true, "invocation_logs": true } },

  "env": {
    // Staging exists because caches.default is inert on *.workers.dev. Hit rates
    // and R2 operation counts — the numbers that decide whether this costs ~$6 or
    // ~$25 a month — can only be measured on a real route.
    "staging": {
      "name": "ragassets-staging",
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "ragassets" }],
      "kv_namespaces": [
        { "binding": "UPDATE_STATE", "id": "ea027318b5124243bbf88f13ab73e0ab" }
      ],
      "vars": { "GITHUB_REPO": "adsonpleal/ragassets" },
      // Only the keys Wrangler does NOT inherit are repeated here: r2_buckets,
      // kv_namespaces and vars are per-environment by design, so omitting them
      // would deploy staging with no bindings at all. assets, triggers and
      // observability ARE inherited, and are deliberately not copied — a second
      // run_worker_first array is one that can be updated in only one place, and
      // this is the copy that actually deploys today.
      "routes": [
        { "pattern": "assets-next.latam-tools.com.br", "custom_domain": true }
      ]
    }
  }
}
