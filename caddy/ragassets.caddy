# ragassets gateway (ragassets-gateway.service, port 8080).
# Deployed to /etc/caddy/conf.d/ragassets.caddy — the main Caddyfile is a stub
# that imports conf.d/*.caddy, so each project owns its own site block.
#
# One name, served DIRECTLY: the DNS record is DNS only, not proxied, so
# browsers reach this box with no CDN in between. Other projects on
# latam-tools.com.br are still proxied — this hostname is the exception, and the
# reason is measured rather than theoretical.
#
# Cloudflare's anycast sent roughly a quarter of Brazilian requests to Miami or
# Newark instead of Rio. A cached render from Rio cost ~122 ms; the same cached
# bytes from Miami cost ~412 ms, and an uncached one ~840 ms. Direct to this box
# the same uncached render costs ~19 ms, because the origin is in São Paulo and
# the users are not. The CDN was losing to the origin it was fronting.
#
# The cache it provided was worth little here anyway: 98.7% of /image requests
# are for a URL nobody has ever asked for, since the query encodes a whole
# character configuration. Only /icons, /maps and /bgm repeat enough to cache,
# and those are cheap static files.
#
# What was given up, so nobody has to rediscover it: DDoS absorption, a WAF,
# and a hidden origin IP. This box is directly addressable and has no scrubbing
# in front of it.
assets.latam-tools.com.br {
	# A publicly-trusted certificate, obtained and renewed by Caddy over ACME
	# HTTP-01. Port 80 must therefore stay open in the firewall — not for
	# visitors, who are redirected to HTTPS, but for the renewal every 60 days.
	# (Re-proxying the record would break this: the proxy terminates :80 and
	# "Always Use HTTPS" turns the challenge into a redirect.)
	#
	# Certificates Caddy manages live in /var/lib/caddy/.local/share/caddy —
	# never delete that directory.

	# Compress the /raw data tables. They are the only text this host serves —
	# everything else is PNG/APNG/GIF/MP3/WAV or already-deflated map blobs, which
	# re-compress to nothing and would just burn CPU. items.json is 8.8 MB of
	# highly repetitive JSON and compresses to about 1.1 MB, and three projects
	# fetch it on every client update.
	@raw path /raw/*
	encode @raw zstd gzip

	reverse_proxy localhost:8080
}

# Deliberately no cache directives above. Every Cache-Control and ETag comes from
# the Go server (internal/api: CacheImmutable, CacheRevalidate, CacheNoStore),
# which is the only thing that knows whether it is answering with an asset, a
# miss, or a failure. With no CDN in front, the browser is the only cache, so
# those headers are the entire caching policy.
