# ragassets gateway (ragassets-gateway.service, port 8080).
# Deployed to /etc/caddy/conf.d/ragassets.caddy — the main Caddyfile is a stub
# that imports conf.d/*.caddy, so each project owns its own site block.
#
# One name, proxied by Cloudflare (orange cloud). Browsers see Cloudflare's edge
# certificate; this one only has to satisfy the proxy, so it is a Cloudflare
# Origin CA certificate — valid 15 years, no renewal machinery, and no dependency
# on this box being reachable from the public internet. The zone must be on
# Full (strict); Flexible would leave this leg plaintext.
#
# The private key is generated ON THE BOX and never leaves it: Cloudflare signs a
# CSR rather than handing out a keypair. Neither file is in this repo, which is
# public.
#
# ACME is deliberately not used here, and the reason is worth knowing before
# someone tries: Cloudflare terminates :80 at the edge and answers an HTTP-01
# challenge itself, "Always Use HTTPS" turns the challenge into a redirect, and
# Caddy's own redirect fights the proxy. DNS-01 via caddy-dns/cloudflare would
# work but needs a custom Caddy build and an API token on the box, for a
# certificate nobody but Cloudflare ever validates.
#
# Certificates Caddy manages itself live in /var/lib/caddy/.local/share/caddy —
# never delete that directory.
assets.latam-tools.com.br {
	tls /etc/caddy/cf-origin.pem /etc/caddy/cf-origin.key

	# Compress the /raw data tables. They are the only text this host serves —
	# everything else is PNG/APNG/GIF/MP3/WAV or already-deflated map blobs, which
	# re-compress to nothing and would just burn CPU. items.json is 8.8 MB of
	# highly repetitive JSON and gzips to roughly an eighth of that, and three
	# projects fetch it on every client update.
	#
	# Cloudflare compresses at the edge too, so this is not for the browser. It is
	# for the origin -> edge leg on every miss and revalidation, and what is scarce
	# here is this box's two cores and single NIC, not Cloudflare's bandwidth.
	@raw path /raw/*
	encode @raw zstd gzip

	reverse_proxy localhost:8080
}

# Deliberately no cache directives above. Every Cache-Control and ETag comes from
# the Go server (internal/api: CacheImmutable, CacheRevalidate, CacheNoStore),
# which is the only thing that knows whether it is answering with an asset, a
# miss, or a failure. Cloudflare's cache rules are configured to honour those
# headers rather than invent a policy; the README records them, because those
# rules live in a dashboard and this is the only version control they get.
