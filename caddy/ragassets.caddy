# ragassets gateway (ragassets-gateway.service, port 8080).
# Deployed to /etc/caddy/conf.d/ragassets.caddy — the main Caddyfile is a stub
# that imports conf.d/*.caddy, so each project owns its own site block.
#
# One name, served DIRECTLY: the DNS record is grey-clouded (DNS only), so
# browsers reach this box rather than Cloudflare's edge. Cloudflare still holds
# the zone, and the other projects on latam-tools.com.br are still proxied — this
# hostname is the exception, and the reason is measured rather than theoretical.
#
# Cloudflare's anycast sent roughly a quarter of Brazilian requests to Miami or
# Newark instead of Rio. A cached render from Rio cost ~122 ms; the same cached
# bytes from Miami cost ~412 ms, and an uncached one ~840 ms. Direct to this box
# the same uncached render costs ~19 ms, because the origin is in São Paulo and
# the users are not. The CDN was losing to the origin it was fronting.
#
# The cache it provided was worth little here anyway: 98.7% of /image requests
# are for a URL nobody has ever asked for, since the query encodes a whole
# character configuration. Only /icons, /maps and /bgm repeat enough to cache,
# and those are cheap static files.
#
# What was given up, so nobody has to rediscover it: Cloudflare's DDoS
# absorption, its WAF, Always Online, tiered caching, and the hidden origin IP.
# This box is now directly addressable and has no scrubbing in front of it.
# The zone's cache rules (cloudflare/cache-rules.json) no longer apply to this
# hostname, and the patch cycle's edge purge is a no-op for it — harmless, since
# there is no edge cache left to go stale.
assets.latam-tools.com.br {
	# A publicly-trusted certificate, obtained and renewed by Caddy over ACME.
	#
	# This block used to carry a Cloudflare Origin CA certificate, which is only
	# valid to Cloudflare and which every browser rejects. That was correct while
	# the record was proxied and no browser ever saw it. It is fatal now, so the
	# certificate has to be a real one.
	#
	# ACME works here for exactly the reason it could not before: nothing
	# intercepts :80 any more. While proxied, Cloudflare terminated port 80 at the
	# edge and "Always Use HTTPS" turned the HTTP-01 challenge into a redirect.
	# Grey-clouded, the challenge arrives at this box. Port 80 must therefore stay
	# open in the firewall — not for visitors, who are redirected to HTTPS, but
	# for the renewal every 60 days.
	#
	# Certificates Caddy manages live in /var/lib/caddy/.local/share/caddy —
	# never delete that directory.

	# Compress the /raw data tables. They are the only text this host serves —
	# everything else is PNG/APNG/GIF/MP3/WAV or already-deflated map blobs, which
	# re-compress to nothing and would just burn CPU. items.json is 8.8 MB of
	# highly repetitive JSON and gzips to roughly an eighth of that, and three
	# projects fetch it on every client update.
	#
	# This used to be for the origin -> edge leg only, since Cloudflare
	# recompressed for the browser. There is no edge now, so it is the browser's
	# compression too, and it is the difference between an 8.8 MB download and a
	# 1.1 MB one on every client update.
	@raw path /raw/*
	encode @raw zstd gzip

	reverse_proxy localhost:8080
}

# Deliberately no cache directives above. Every Cache-Control and ETag comes from
# the Go server (internal/api: CacheImmutable, CacheRevalidate, CacheNoStore),
# which is the only thing that knows whether it is answering with an asset, a
# miss, or a failure. That was true when Cloudflare sat in front honouring those
# headers, and it is still true now that the browser is the only cache left —
# which makes the Go server's headers the entire caching policy rather than most
# of it.
